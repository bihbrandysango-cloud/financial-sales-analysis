	measure 'Sales Sparkline' =
			VAR _start = CALCULATE ( MIN ( financials[Date] ), ALL ( financials ) )
			VAR _w = 240
			VAR _h = 34
			VAR _months =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, 15, 1 ),
			        "@v",
			            VAR _s = EDATE ( _start, [Value] )
			            RETURN
			                CALCULATE (
			                    [Total Sales],
			                    REMOVEFILTERS ( financials[Date], financials[Year], financials[Month Number], financials[Month Name], financials[Quarter], financials[Month Start], financials[Month Label] ),
			                    financials[Date] = _s
			                ) + 0
			    )
			VAR _min = MINX ( _months, [@v] )
			VAR _max = MAXX ( _months, [@v] )
			VAR _pts =
			    CONCATENATEX (
			        _months,
			        FORMAT ( 4 + [Value] * ( _w - 8 ) / 15, "0" ) & ","
			            & FORMAT ( _h - 6 - DIVIDE ( [@v] - _min, _max - _min ) * ( _h - 12 ), "0" ),
			        " ",
			        [Value], ASC
			    )
			VAR _lastY = FORMAT ( _h - 6 - DIVIDE ( MAXX ( FILTER ( _months, [Value] = 15 ), [@v] ) - _min, _max - _min ) * ( _h - 12 ), "0" )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _w & "' height='" & _h & "'>"
			        & "<polygon points='4," & _h & " " & _pts & " " & ( _w - 4 ) & "," & _h & "' fill='%230E7C86' fill-opacity='0.14'/>"
			        & "<polyline points='" & _pts & "' fill='none' stroke='%230E7C86' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round'/>"
			        & "<circle cx='" & ( _w - 4 ) & "' cy='" & _lastY & "' r='3.5' fill='%23F5A524'/>"
			        & "</svg>"
		displayFolder: Modern KPIs
		lineageTag: 68344287-638e-4115-8407-0e400f6ef5f1
		dataCategory: ImageUrl

