                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Protect Government. ",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#0B3C49"
                    }
                  },
                  {
                    "value": "It earns 67% of profit. Keep pricing and service strong in this segment.",
                    "textStyle": {
                      "fontSize": "15pt",
                      "color": "#1F2D33"
                    }
                  }
                ]
              },
