                      "fontSize": "8pt",
                      "color": "#1F2D33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Fix Enterprise. ",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#0B3C49"
                    }
                  },
                  {
                    "value": "Review the 58 loss-making sales. Stop medium and high discounts that push it below cost.",
                    "textStyle": {
                      "fontSize": "15pt",
                      "color": "#1F2D33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#1F2D33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Cap deep discounts. ",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#0B3C49"
                    }
                  },
                  {
                    "value": "Margin drops to 9.1% at the high band. Set limits and approve exceptions.",
                    "textStyle": {
                      "fontSize": "15pt",
                      "color": "#1F2D33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#1F2D33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. Back Paseo and stock for Q4. ",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#0B3C49"
                    }
                  },
                  {
                    "value": "It leads profit and units, and October and December are the biggest months.",
                    "textStyle": {
                      "fontSize": "15pt",
                      "color": "#1F2D33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#1F2D33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "5. Grow Mexico and Channel Partners. ",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#0B3C49"
                    }
                  },
                  {
                    "value": "Mexico sells least. Channel Partners earn a 73% margin on only $1.8M of sales.",
