                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Top month and product",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontWeight": "bold",
                      "color": "#0B3C49"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Paseo in December 2014 ($4.7M). By calendar month across both years, Paseo in November leads ($7.7M).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1F2D33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Careful with years",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontWeight": "bold",
                      "color": "#0B3C49"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2013 covers only September to December, so years cannot be compared fairly.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1F2D33"
                    }
